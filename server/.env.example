# 복사해서 server/.env 로 저장하세요. (.env 는 git에 올리지 마세요)

PORT=8080

# MongoDB Atlas 연결 문자열 (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=chat_site

# 세션 토큰 서명 키. 길고 무작위인 문자열 (예: openssl rand -hex 32)
JWT_SECRET=change-me

# 클라이언트(env.js)와 같은 값. 여러 개면 쉼표로 구분
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# 접속을 허용할 웹 주소 (GitHub Pages 주소). 여러 개면 쉼표로 구분, * 는 모두 허용
ALLOWED_ORIGINS=https://ish0503.github.io,http://localhost:5173

# 첨부파일 다운로드 유효기간(시간)과 최대 크기(MB)
FILE_TTL_HOURS=72
MAX_UPLOAD_MB=25
